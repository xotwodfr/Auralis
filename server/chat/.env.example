# Copy to .env (git-ignored). No secrets in this file: the database password lives in ./secrets/db_password (mode 600).
CHAT_SERVER_NAME="Auralis Chat"
# 127.0.0.1 behind Tailscale Serve / a tunnel / Caddy, or the LAN IP for direct LAN access (CHAT.md §9).
CHAT_BIND_ADDRESS=127.0.0.1
CHAT_PORT=8790
# closed | invite | open. closed: accounts only from the CLI.
CHAT_REGISTRATION=closed
# Exact origins (never *) of browser/webview clients. Native apps send no Origin and are unaffected.
# Desktop: tauri://localhost (Linux/macOS), http://tauri.localhost (Windows, and Android [verify on a device]).
# Web dev server: http://localhost:5173
CHAT_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost
# 1 (last X-Forwarded-For hop) or cloudflare (CF-Connecting-IP, Cloudflare Tunnel only), and only when bound to
# 127.0.0.1 behind a proxy you control (refused otherwise).
CHAT_TRUST_PROXY=0
CHAT_LOG_LEVEL=info
CHAT_SESSION_IDLE_DAYS=30
CHAT_SESSION_MAX_DAYS=180
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_GROUP_MEMBERS=64
CHAT_MAX_SOCKETS_PER_USER=10
CHAT_DELETED_RETENTION_DAYS=30
# Navidrome/Subsonic URL as reachable from the chat container. When set, every Navidrome user can sign in to chat with
# their Navidrome username and password; the chat account is created on first sign-in. Admin accounts are never affected.
# CHAT_NAVIDROME_URL=https://music.example.com
# Image tag used by compose.yaml (set to the release tag when upgrading).
CHAT_VERSION=local
