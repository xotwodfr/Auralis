# Copy to .env (git-ignored) and fill in. Server-side only: these names deliberately do NOT start with VITE_,
# so Vite never ships them to the browser.

# Secret key from https://developers.spicylyrics.org/dashboard (shown once). Leave empty to disable the integration.
SPICY_LYRICS_SECRET_KEY=

# Automatic Spotify matching (optional). Spicy Lyrics is looked up by Spotify track id; with these set, the backend finds
# that id by searching Spotify for the playing track (Client Credentials flow). Without them, tracks can still be linked
# by hand on Now Playing. Create an app at https://developer.spotify.com/dashboard (Web API). Spotify requires the app
# owner to have an active Premium subscription for Development Mode apps (since Feb 2026).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional
# SPOTIFY_MARKET=SE                   # ISO country code: restrict matches to tracks available in your country
# SPICY_LYRICS_API_BASE=https://api.spicylyrics.org
# SPICY_RATE_PER_MINUTE=30            # per client address, to protect your API quota
# Exact origins (never *) allowed to call the API from a browser/webview. Desktop: Linux/macOS tauri://localhost, Windows
# http://tauri.localhost. Add the hosted web app's origin too if it is served from a different host.
AURALIS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost
# TRUST_PROXY=1                       # set by docker-compose.yml; only behind a reverse proxy you control: use X-Forwarded-For for rate limiting
# PORT=8787
# HOST=127.0.0.1
